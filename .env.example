# Copy to .env (gitignored) and fill in real values for local dev/testing.
# For Jenkins, these same values should be configured as the
# "minio-credentials" Jenkins credential (see infra-GitlabBackup.groovy) -
# not read from this file, since Jenkins runs the playbook against
# whatever MinIO is actually reachable in that environment.
MINIO_ROOT_USER=gitlabbackup
MINIO_ROOT_PASSWORD=change-me-to-a-real-secret
