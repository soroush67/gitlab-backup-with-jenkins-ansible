# Copy to .env (gitignored) and fill in real values for local dev/testing.
# For Jenkins, these same values should be configured as the
# "object-storage-credentials" Jenkins credential (see infra-GitlabBackup.groovy) -
# not read from this file, since Jenkins runs the playbook against whatever
# RustFS/object storage is actually reachable in that environment.
RUSTFS_ACCESS_KEY=gitlabbackup
RUSTFS_SECRET_KEY=change-me-to-a-real-secret
